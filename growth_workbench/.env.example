WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=4310
OPEN_BROWSER=1
# 默认自动识别上一级 Content OS 工程；移动目录后可手动指定：
# CONTENT_OS_ROOT=C:\path\to\ContentOS
# 日常工作数据可单独放到其他磁盘：
# WORKBENCH_DATA_DIR=C:\path\to\GrowthWorkbenchData
# 安全提示：默认交付包不含 Content OS 语料。请把这里指向本机受控的 Content OS 根目录。

# 林总风格生成引擎（OpenRouter / OpenAI 兼容协议；密钥只填写在本机 .env，默认不会进入 ZIP）
LIN_LLM_BASE_URL=https://openrouter.ai/api/v1
LIN_LLM_MODEL=minimax/minimax-m3:free
OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=Yujie Growth Workbench V0.1
LIN_LLM_TEMPERATURE=0.85
LIN_LLM_MAX_TOKENS=12000
LIN_LLM_REASONING_EFFORT=low
LIN_LLM_TIMEOUT_MS=120000
# 默认在发送给外部模型前隐藏内部知识中的金额与比例；确认私有部署安全后才考虑关闭。
LIN_REDACT_SENSITIVE=true
